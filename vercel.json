{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/{codex/**,video-feed.json}"
    },
    "api/studio/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/video/studio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://res.cloudinary.com; media-src 'self' blob: https://res.cloudinary.com; connect-src 'self' https://api.cloudinary.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/codex",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/codex/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/kanban",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/newsflow/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/data/video-feed.json",
      "destination": "/api/videos",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "subscribe.thevillager.today"
        }
      ],
      "destination": "/subscribe-villager/",
      "permanent": false
    },
    {
      "source": "/services/:path*",
      "destination": "/api/newsflow",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apikeys",
      "destination": "/apistore"
    },
    {
      "source": "/video/studio",
      "destination": "/video/studio.html"
    },
    {
      "source": "/video",
      "destination": "/video/index.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/console/api/hermes/:path*",
      "destination": "https://codex.conews.press/api/v1/platform/hermes/:path*"
    },
    {
      "source": "/newsflow",
      "destination": "/newsflow/index.html"
    },
    {
      "source": "/api/vault/:path*",
      "destination": "/api/newsflow"
    },
    {
      "source": "/api/prompts/:path*",
      "destination": "/api/newsflow"
    },
    {
      "source": "/api/newsflow/:path*",
      "destination": "/api/newsflow"
    },
    {
      "source": "/sse",
      "destination": "/api/newsflow"
    },
    {
      "source": "/message",
      "destination": "/api/newsflow"
    }
  ]
}
