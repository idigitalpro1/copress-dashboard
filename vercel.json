{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/{codex/**,video-feed.json}"
    }
  },
  "headers": [
    {
      "source": "/codex",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/codex/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/kanban",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/data/video-feed.json",
      "destination": "/api/videos",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "subscribe.thevillager.today"
        }
      ],
      "destination": "/subscribe-villager/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/video/review-continue",
      "destination": "/video/review-continue.html"
    },
    {
      "source": "/video/review",
      "destination": "/video/review.html"
    },
    {
      "source": "/video/submit",
      "destination": "/video/submit.html"
    },
    {
      "source": "/video",
      "destination": "/video/index.html"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/console/api/hermes/:path*",
      "destination": "https://codex.conews.press/api/v1/platform/hermes/:path*"
    }
  ]
}
