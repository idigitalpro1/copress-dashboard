# No real secrets belong in this file. Existing SATCOM provider variables remain separate.
NEWSFLOW_BETA_ENABLED=0
NEWSFLOW_MCP_TOKEN=
NEWSFLOW_MASTER_KEY=
# Set an absolute directory on a persistent local disk, outside the public website.
NEWSFLOW_DATA_DIR=
NEWSFLOW_ALLOWED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321
# Paid model execution is disabled until explicitly enabled by the operator.
NEWSFLOW_ALLOW_EXECUTION=0
# SATCOM Studio copy uses this server variable; browser cards do not provision it.
GEMINI_KEY_COPY=
